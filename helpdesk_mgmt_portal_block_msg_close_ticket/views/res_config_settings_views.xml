<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form (helpdesk_mgmt_portal_block_msg_close_ticket)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="helpdesk_mgmt.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='show_categories_form']" position="after">
                <setting
                    string="Messages"
                    id="blocl_messages"
                    help="Block send messages on closed tickets."
                >
                    <div class="mt16">
                        <div class="content-group">
                            <div>
                                <field
                                    name="helpdesk_mgmt_portal_no_msgs_close_ticket"
                                    string="Block"
                                />
                                <label for="helpdesk_mgmt_portal_no_msgs_close_ticket" />
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
