<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="helpdesk_team_personal_rule" model="ir.rule">
            <field name="name">Personal Teams</field>
            <field ref="helpdesk_mgmt.model_helpdesk_ticket_team" name="model_id" />
            <field
                name="domain_force"
            >[('id', 'in', user.helpdesk_team_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user_own'))]" />
            <field name="perm_read" eval="True"/>
        </record>
        <record id="helpdesk_all_teams_rule" model="ir.rule">
            <field name="name">All Teams</field>
            <field ref="helpdesk_mgmt.model_helpdesk_ticket_team" name="model_id" />
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user'))]" />
            <field name="perm_read" eval="True"/>
        </record>
