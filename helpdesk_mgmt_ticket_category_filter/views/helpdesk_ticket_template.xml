<odoo>
    <template id="helpdesk_dynamic_category_template" inherit_id="helpdesk_mgmt.portal_create_ticket">

        <xpath expr="//div[./label[@for='category']]" position="attributes">
            <attribute name="style">display:none;</attribute>
        </xpath>

        <xpath expr="//div[./label[@for='category']]" position="after">
            <div class="form-group">
                <label class="col-md-3 col-sm-4 control-label" for="parent-category">Category</label>
                <div class="col-md-7 col-sm-8">
                    <select class="form-control" id="parent-category" name="parent_category_id" required="required">
                        <option value=""/>
                        <t t-foreach="categories.filtered(lambda x: not x.parent_id)" t-as="category">
                            <option t-attf-value="#{category.id}">
                                <t t-esc="category.complete_name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div class="form-group" id="subcategory-container">
                <label class="col-md-3 col-sm-4 control-label" for="category_id">Subcategory</label>
                <div class="col-md-7 col-sm-8">
                    <select class="form-control" id="category_id" name="category_id" disabled="disabled" required="required">
                        <option value=""/>
                    </select>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
