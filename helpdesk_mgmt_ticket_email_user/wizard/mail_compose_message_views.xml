<odoo>
    <data>
        <record id="email_compose_message_wizard_form" model="ir.ui.view">
            <field name="name">mail.compose.message.form (helpdesk_mgmt_ticket_email_user)</field>
            <field name="model">mail.compose.message</field>
            <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_ids']/.." position="after">
                    <label for="custom_dest_partner_ids"/>
                    <div>
                        <field name="custom_dest_partner_ids" widget="many2many_tags"  domain="[('id', '=', False)]" options="{'no_create': True}"></field>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
